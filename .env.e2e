# E2E build mode — points the app at the local mock Supabase
# (tests/mock/supabase-server.mjs). These values are fake on purpose and are
# safe to commit: the mock only ever serves fictional example.test accounts
# on 127.0.0.1. Real credentials never live in the repository.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=mock-anon-key
