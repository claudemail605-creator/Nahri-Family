# Copy this file to `.env` and fill in the values (`.env` is git-ignored).
#
# These two values come from: Supabase dashboard -> Project Settings -> API.
# The URL is the project URL (https://<project-ref>.supabase.co) and the key is
# the PUBLISHABLE (anon) key. Both are safe to ship to browsers — they are not
# secrets — but keeping them in `.env` keeps environments separate.
#
# NEVER put the service-role key here. It belongs only in the server-side
# environment of the `admin-users` Edge Function (see docs/SUPABASE.md).

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-ANON-KEY
