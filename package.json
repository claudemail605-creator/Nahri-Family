{
  "name": "nahri-family",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Nahri Family — a private family history archive (family tree, photos, admin tools).",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "test:e2e": "playwright test",
    "e2e:server": "vite build --mode e2e && vite preview --port 4173 --strictPort",
    "check": "npm run typecheck && npm run test && npm run build",
    "extract:i18n": "node scripts/extract-i18n.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "xlsx": "^0.18.5"
  }
}
